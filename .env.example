# Copy to .env (git-ignored) and change what you need. One file for the whole project: `just` loads it into every recipe,
# and the backend (main.py) and the frontend (next.config.ts) read it when started on their own. Variables set in the shell win.

# Frontend: where the FastAPI backend runs. Next proxies /api/* there, and lib/wordle/feedback.test.ts calls it.
BACKEND_URL=http://127.0.0.1:8000

# Backend: origins allowed to call the API from a browser, comma-separated (e.g. http://localhost:5173,http://192.168.1.60:3000), or * for any.
# Empty: no CORS headers. The website doesn't need them, since Next proxies /api to the backend.
CORS_ORIGINS=
